{
  "name": "@jgoterris/orbit",
  "version": "0.7.1",
  "description": "Terminal UI to launch, control and monitor local services",
  "type": "module",
  "license": "MIT",
  "author": "Jesús Goterris",
  "keywords": [
    "tui",
    "cli",
    "docker",
    "compose",
    "process-manager",
    "bun",
    "services"
  ],
  "bin": {
    "orbit": "./bin/orbit.mjs"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "assets/logo.svg",
    "orbit.schema.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun src/index.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun test && bun run typecheck"
  },
  "dependencies": {
    "@opentui/core": "^0.5.13",
    "@opentui/react": "^0.5.13",
    "react": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
